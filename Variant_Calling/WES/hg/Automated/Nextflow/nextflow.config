params.help = false

params.run_dir = 'path/to/topdir'
params.sample_dir = 'path/to/topdir/sampledir'
params.date = new Date().format('yyyyMMdd')

params.gene_filter_script = 'Gene_filter_v4.py'
params.gene_panel_file_1 = 'ACMG_SF_v3.3_Gene_list.txt'
params.gene_panel_file_2 = 'NW_378Genes_Panel_MOD.txt'
params.keep_intronic = 'Yes'
params.folders = 1
params.output_filename_1 = 'ACMGGenes_Panel_Output.xlsx'
params.output_filename_2 = '378Genes_Panel_Output.xlsx'

workDir = "${params.run_dir}/work"
report {
    enabled = true
    file = "${params.run_dir}/output/report.html"
    overwrite = true
}

profiles {
  hpc_slurm { 
    process {
      executor = 'slurm'
      withName: concatFastqs {
            cpus = 1
            memory = '2 GB'
            queue = 'genomics'
            time = '1h'
            clusterOptions = '-A b1042'
        }     
      withName: fastqcArray {
            beforeScript = 'module load java/jdk1.8.0_191'
            cpus = 1
            memory = '8 GB'
            queue = 'genomics'
            time = '2h'
            clusterOptions = '-A b1042 -n 6 -J 21-2490 -o fastqc_%A_%a.out -e fastqc_%A_%a.err'   
        }
      withName: WESanalysis {
            cpus = 1
            memory = '100 GB'
            queue = 'genomics'
            time = '24h'
            clusterOptions = '-A b1042 -n 16 -J SampleID -o SampleID_%j.out -e SampleID_%j.err'
        }
      withName: multiQC {
            beforeScript = 'module load java/jdk-17.0.2+8'
            cpus = 1
            memory = '1 GB'
            queue = 'genomics'
            time = '1h'
            clusterOptions = '-A b1042 -J multiqc -o multiqc.out -e multiqc.err'
        }
      withName: geneFilter {
            cpus = 1
            memory = '4 GB'
            queue = 'genomics'
            time = '3h'
            clusterOptions = '-A b1042'
        }
    }
  }
}